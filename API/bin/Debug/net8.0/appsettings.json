{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PropertyFlipperAPI",
    "Audience": "PropertyFlipperClient",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:8080", "http://localhost:5000", "http://localhost:3001", "http://127.0.0.1:3000", "http://127.0.0.1:3001"]
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "Development",
    "TracesSampleRate": 1.0,
    "SendDefaultPii": false
  },
  "FCM": {
    "ServerKey": "",
    "SenderId": "",
    "Note": "Get these values from Firebase Console > Project Settings > Cloud Messaging"
  },
  "Firebase": {
    "ProjectId": "",
    "CredentialsPath": "",
    "Note": "ProjectId from Firebase Console. CredentialsPath is optional - path to service account JSON file"
  }
}
