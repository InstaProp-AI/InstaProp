{
  "$schema": "https://railway.app/railway.schema.json",
  "$service": {
    "source": "api"
  },
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "API/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet InstapropAPI.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

